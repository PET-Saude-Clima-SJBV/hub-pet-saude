# Copie para .env (o .env NUNCA vai para o Git)
# Valores do ambiente LOCAL - podem ficar assim.

# Banco local (docker compose up -d)
POSTGRES_DB=hub_local
POSTGRES_USER=hub
POSTGRES_PASSWORD=hub
DB_PORT=5432

# Backend (cd backend && npm run dev)
AMBIENTE=local
DATABASE_URL=postgresql://hub:hub@localhost:5432/hub_local
JWT_SEGREDO=troque-isto-no-local-tambem
# Primeiro administrador, criado automaticamente se o banco não tiver nenhum
ADMIN_EMAIL=voce@exemplo.com
ADMIN_NOME=Seu Nome
ADMIN_SENHA_INICIAL=senha-local-123
